# Copia este archivo como .env y completa los valores (nunca subas .env al repo)
# Proveedor de LLM gratuito para el agente de insights (https://console.groq.com)
GROQ_API_KEY=

# MLflow remoto en DagsHub (Fase 4). Token en: Settings > User settings > Tokens
# Repo = nombre del repositorio creado en DagsHub (p.ej. ML2_Series_de_tiempo)
DAGSHUB_TOKEN=
DAGSHUB_REPO=
